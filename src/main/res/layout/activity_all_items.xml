<?xml version="1.0" encoding="utf-8"?>
<!--
    All Items Screen Layout

    Purpose:
      - Displays a complete list of all food items belonging to the user.
      - Used by AllItemsActivity.
      - Shows items sorted by expiry urgency (handled in Activity/Service layer).

    Architectural Role:
      - Pure UI layout; contains no logic.
      - Works with AllItemsAdapter to render FoodItem rows.
      - Demonstrates separation of concerns: layout = structure, Activity = behaviour.

    Notes:
      - ListView is appropriate here because the list is static and not paginated.
      - Title text is static ("All Items") but could be made dynamic if needed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:padding="16dp"
              android:layout_width="match_parent"
              android:layout_height="match_parent">

    <!-- Screen title -->
    <TextView
            android:id="@+id/allItemsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Items"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

    <!-- List of all items (populated by AllItemsAdapter) -->
    <ListView
            android:id="@+id/allItemsListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:dividerHeight="8dp" />

</LinearLayout>
